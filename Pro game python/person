class Person():
    def __init__(self, countary, name, age ,contact, gender):
        self.countary = countary
        self.name = name
        self.age = age
        self.contact = contact
        self.gender = gender
    def show(self):
        print(self.countary,self.name,self.contact, self.gender)

Person1 = Person("india", "Bill", 45, 9090909, "boy")
person2 = Person("USA", "Isabella", 53, 9526840, "girl")
Person1.show()
person2.show()

     